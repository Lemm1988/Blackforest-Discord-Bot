# Vorlage fuer bot/.env - Werte eintragen und diese Datei als ".env" speichern.
# .env selbst ist in .gitignore und wird NIE committet.
# Siehe BlackforestBot-Dokumentation.md, Abschnitt 9 (OAuth-Setup) fuer Details.

# Discord Bot Token (Discord Developer Portal -> Bot -> Token)
DISCORD_TOKEN=

# Discord OAuth2 App-Zugangsdaten (Discord Developer Portal -> OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Discord-User-ID, die beim allerersten Start automatisch is_admin bekommt
# (nur wirksam, solange user_permissions komplett leer ist)
BOOTSTRAP_ADMIN_DISCORD_ID=

# Discord-User-ID des Bot-Owners - unveraenderlicher Schutz-Account, siehe
# Dokumentation Abschnitt 5+7. Kann NICHT ueber die Web-UI/Bot-Befehle entzogen werden.
BOT_OWNER_ID=

# Zufaelliger 64-stelliger Hex-String fuer Flask-Session-Cookies, z.B. erzeugen mit:
# python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
