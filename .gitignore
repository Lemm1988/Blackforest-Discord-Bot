# Secrets - niemals committen
.env
*.env
backend/ssl/*.key
backend/ssl/*.crt

# Datenbanken (enthalten Nutzerdaten)
*.db
*.db-journal

# Python
__pycache__/
*.pyc
venv/
.venv/

# Logs
*.log

# Backups (DB- und .env-Snapshots, teils ohne erkennbare Dateiendung - nie ins Repo)
/backups/

# Test-/IDE-Artefakte
.pytest_cache/
.idea/
.vscode/
*.iml
.DS_Store

# breiter gefasst fuer Zertifikate/Schluessel, nicht nur unter backend/ssl/
*.pem

# Zeitgestempelte Backup-Dateien mit untypischer Endung (z.B. bot.db.bak_20260829_...)
*.bak_*

# Rust (android-app/, dumbpipe-Build wird von GitHub Actions frisch geklont, nicht vendored)
target/
Cargo.lock
*.rs.bk
dumbpipe-src/
output/

# Android / Gradle (fuer die kuenftige Kotlin-App unter android-app/)
.gradle/
local.properties
build/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.jks
*.keystore
